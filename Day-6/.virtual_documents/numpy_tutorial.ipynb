# Multi-Dimensional arrays

arry2D = np.array([[1,2,3], [7,5,7], [4,9,0]])
print(arry2D, arry2D.dtype) 

sum_of_columns = np.sum(arry2D, axis=0) #columns, axis=0 means columns
print(sum_of_columns)

sum_of_rows = np.sum(arry2D, axis=1) #rows, axis=1 means row
print(sum_of_rows)

print("<-----------Accessing the elements----------->")
print(arry2D[0:2, 1:2])





