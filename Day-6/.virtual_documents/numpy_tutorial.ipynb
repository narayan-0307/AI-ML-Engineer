# Normalize

arr = np.array([[1, 2], [3, 4]])

mean = np.mean(arr)
print(mean)

std_dev = np.std(arr)
print(std_dev)

normalized_arr = (arr - mean) / std_dev
print(normalized_arr)





# Mathematical Functions:

# 1. Aggregations

arr = np.array([1, 2, 3, 4, 5])

print(np.sum(arr)) #Addition
print(np.prod(arr)) # Multiply all values: e.g. 1 X 2 X 3 X 4 X 5 = 120
print(np.min(arr))
print(np.max(arr))
print(np.argmin(arr)) # Return the index number of the minimum value, like 1, which is 0th index
print(np.argmax(arr)) # Return the index number of the minimum value, like 5, which is 4th index
print(np.mean(arr))
print(np.std(arr))
print(np.median(arr))
print(np.var(arr))


# Power Function

arr = np.array([1, 2, 3, 4, 5])

print(np.square(arr))
print(np.sqrt(arr))
print(np.pow(arr, 3)) # a to the power b


# Log & Exponential

arr = np.array([1, 2, 3, 4, 5])

print(np.log(arr))
print(np.log10(arr))
print(np.exp(arr))


# Rounding

print(np.round(3.14))
print(np.ceil(3.14)) # highest nearest
print(np.floor(3.14)) # Lowesr nearest
print(np.trunc(3.14))

arr = np.array([1,2,4,3,2,5,4,3,6,3])
print(np.unique(arr)) # Print the unique value
print(np.sort(arr)) # Sorting the all values

