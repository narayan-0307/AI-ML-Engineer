# Filtering The Data:-
df[df["aqi"] > 100] # find greater than 100 values

df[(df["aqi"] > 100) & (df["temperature"] > 30)] # Multiple conditions

df[df["aqi"] > 100][["city", "aqi"]] #Greater than 100 with columns city and aqi only

aqi_data = df[ (df["aqi"] > 100) & (df["temperature"] > 30)][["city", "aqi"]] #Greater than 100 with columns city and aqi only

aqi_data

aqi_data.iloc[0]

# aqi_data.loc[0]
aqi_data.loc[6]



# Query rules: query() returns the copy of the data

df.query("aqi > 100")

df.query("aqi > 100 & temperature > 30")[["aqi", "temperature"]]

# @ to reference Python vars

aqi_var = 100
df.query("aqi > @aqi_var")

# query returns the copy of the data not view the data
aqi_data = df.query("aqi > 100 & temperature > 30")[["aqi", "temperature"]].copy()


aqi_data








# Missing values - Cleaning data

df = pd.read_csv("raw_data.csv")
df


df.isnull() # Find missing values

df.isnull().sum() # Count the null value for each component

df.dropna() #Drop the ROW if there is null value available
df.dropna(axis=1) #Drop the COLUMNS if there is null value available

df.fillna(0) # Fill with the missing values any missing value
# df["age"].fillna(df["age"].mean())

age_mean = df["age"].mean()

cleaned_data = df.copy() # Step - 1: create the copy for original data
age_mean = cleaned_data["age"].mean()
cleaned_data["age"] = cleaned_data["age"].fillna(age_mean) # step - 2: access the cleaned_data and add the age_mean value

# cleaned_data

#ffill(): carrying forward the last known (previous) non-missing value.
df.ffill()

#bfill(): filling missing values using the next available (future) non-missing value.
df.bfill()


